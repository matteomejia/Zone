<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <!-- Discovery uses the Windows desktop DNS-SD API in dnsapi.dll. -->
    <TargetFramework>net8.0-windows10.0.19041.0</TargetFramework>
    <RootNamespace>Zone.Core</RootNamespace>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <LangVersion>12</LangVersion>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
  </PropertyGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="Zone.Tests" />
    <PackageReference Include="Microsoft.Data.Sqlite" Version="8.0.33" />
  </ItemGroup>

</Project>
